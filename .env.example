# Medición de visitas y contactos (opcional). Copia este archivo como .env y completa UNA opción.
# Eventos que se registran: whatsapp_click, social_click, form_submit

# Opción 1: Plausible (de pago, sin cookies) → el dominio registrado en plausible.io
PUBLIC_PLAUSIBLE_DOMAIN=

# Opción 2: Google Analytics 4 (gratis) → el ID de medición, por ejemplo G-XXXXXXXXXX
PUBLIC_GA_ID=
