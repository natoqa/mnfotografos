---
import { branches } from '../data/site';
---

<!-- ===== MN STUDIO + MN WORKSHOP: cada mitad lleva a su página ===== -->
<section class="branches" id="studio-workshop" aria-label="MN Studio y MN Workshop">
  {branches.map(branch => (
    <a class="branch" id={branch.id} href={`/${branch.id}`}>
      <div class="ph branch__bg"><img src={branch.image} alt="" loading="lazy" onerror="this.remove()" /></div>
      <div class="branch__body">
        <h2 class="branch__name"><span>MN</span>{branch.name}</h2>
        <p class="branch__text">{branch.text}</p>
        <span class="branch__cta">{branch.more}</span>
      </div>
    </a>
  ))}
</section>
