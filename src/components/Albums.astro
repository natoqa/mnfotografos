---
import { albums, albumsBackdrop } from '../data/site';
---

<!-- ===== PORTAFOLIO ===== -->
<section class="albums" id="albumes" aria-label="Álbumes" data-nav-keep style={`--n:${albums.length + 1}`}>
  <div class="albums__sticky">
    <!-- Fondo: fotos que aparecen y se desvanecen en posiciones al azar -->
    <div class="albums__drift" id="albumsDrift" aria-hidden="true" data-photos={JSON.stringify(albumsBackdrop)}></div>
    <div class="albums__track" id="albumsTrack">
      <div class="panel panel--intro">
        <h2 class="h-display">Álbumes</h2>
        <p>Tres historias recientes. Sigue bajando para recorrerlas.</p>
      </div>
      {albums.map((album, i) => (
        <article class="panel" aria-label={album.label}>
          <div class="ph panel__photo"><img src={album.image} alt={album.label} loading="lazy" onerror="this.remove()" /></div>
          <div class="panel__info">
            <p class="panel__count">{i + 1} de {albums.length}</p>
            <div>
              <h3 class="panel__title">{album.title.map(line => <span><span>{line}</span></span>)}</h3>
              <div class="panel__meta"><span>{album.place}</span><a class="link" href={`/albumes/${album.slug}`}>Ver álbum</a></div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="albums__progress" aria-hidden="true"><i id="albumsBar"></i></div>
  </div>
</section>

<script>
  /* Álbumes: fondo negro al entrar + scroll vertical que mueve la galería en horizontal */
  const nav = document.getElementById('nav')!;
  const albums = document.getElementById('albumes')!;
  const track = document.getElementById('albumsTrack')!;
  const bar = document.getElementById('albumsBar')!;
  const drift = document.getElementById('albumsDrift')!;
  const panels = [...track.children];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  // Pausa al final: el último álbum queda quieto este tramo (en altos de pantalla) antes de soltar la sección,
  // para que el recorrido suavizado alcance a terminar. Debe coincidir con el "+ 60vh" de .albums en global.css
  const HOLD = 0.6;
  // Tope: parte de cada tramo de scroll en la que la boda queda quieta y encajada en la pantalla (0 = sin pausa)
  const STOP = 0.45;
  const steps = panels.length - 1;
  // Convierte el avance continuo del scroll en avance "por paradas": quieto, se desliza a la siguiente, quieto…
  const snap = (t: number) => {
    const p = t * steps;
    const i = Math.min(Math.floor(p), steps - 1);
    const m = Math.min(1, Math.max(0, (p - i - STOP / 2) / (1 - STOP)));
    return (i + (m < .5 ? 2 * m * m : 1 - (-2 * m + 2) ** 2 / 2)) / steps;
  };
  let target = 0, current = 0;
  let visible = false, running = false;

  const readAlbums = () => {
    const r = albums.getBoundingClientRect();
    const dark = r.top < innerHeight * 0.5 && r.bottom > innerHeight * 0.5;
    albums.classList.toggle('is-dark', dark);
    nav.classList.toggle('is-dark', dark);
    const max = albums.offsetHeight - innerHeight - innerHeight * HOLD;
    target = Math.min(1, Math.max(0, -r.top / max));
    if (target !== current) start();
  };
  const loop = () => {
    // Fuera de pantalla y casi en reposo: se fija en su posición final y se detiene para no gastar batería
    const settle = !visible && Math.abs(target - current) < 0.0005;
    current = settle ? target : current + (reduce.matches ? (target - current) : (target - current) * 0.09);
    const pos = snap(current);
    const dist = track.scrollWidth - track.clientWidth;
    track.style.transform = `translate3d(${-pos * dist}px,0,0)`;
    bar.style.transform = `scaleX(${current})`;
    const idx = Math.round(pos * steps);
    panels.forEach((p, i) => { if (i === idx && i > 0) p.classList.add('is-active'); });
    // Las fotos del fondo solo acompañan la portada "Álbumes": al pasar a una boda se desvanecen y queda solo ella
    drift.classList.toggle('is-off', idx > 0);
    if (settle) { running = false; return; }
    requestAnimationFrame(loop);
  };
  const start = () => { if (!running) { running = true; requestAnimationFrame(loop); } };

  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    if (visible) { readAlbums(); start(); }
    // Al salir por completo de la sección, los paneles vuelven a su estado inicial
    // para que la animación se repita al entrar de nuevo
    else panels.forEach(p => p.classList.remove('is-active'));
  }).observe(albums);

  /* Fondo: cada cierto tiempo aparece una foto en un hueco libre, flota un poco y se desvanece */
  const photos: string[] = JSON.parse(drift.dataset.photos!);
  // Huecos posibles: [izquierda %, arriba %, ancho vw]. Cargados a la derecha y arriba, donde el negro queda más vacío
  const SLOTS = [[56, 4, 13], [76, 14, 11], [38, 6, 9], [64, 40, 10], [86, 54, 9], [46, 34, 8], [72, 70, 9], [24, 22, 8]];
  const busy = new Set<number>();
  let next = Math.floor(Math.random() * photos.length);
  const spawn = async () => {
    if (!visible || !albums.classList.contains('is-dark') || drift.classList.contains('is-off') || document.hidden || reduce.matches) return;
    const free = SLOTS.map((_, i) => i).filter(i => !busy.has(i));
    if (!free.length) return;
    const slot = free[Math.floor(Math.random() * free.length)];
    const [left, top, w] = SLOTS[slot];
    busy.add(slot);
    const img = new Image();
    img.src = photos[next++ % photos.length];
    img.alt = '';
    img.className = 'drift';
    img.style.cssText = `left:${left}%;top:${top}%;width:max(80px,${w}vw)`;
    try { await img.decode(); } catch { busy.delete(slot); return; } // si no carga, se salta sin dejar un hueco roto
    img.addEventListener('animationend', () => { img.remove(); busy.delete(slot); });
    drift.append(img);
  };
  setInterval(spawn, 700);

  readAlbums();
  addEventListener('scroll', readAlbums, { passive: true });
  addEventListener('resize', () => { readAlbums(); start(); });
  start();
</script>
